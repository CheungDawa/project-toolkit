# Project Toolkit 环境变量示例（复制为 .env 后按需修改）
# 数据库口令：仅本机部署也应改为随机值（生产更换见部署文档）
POSTGRES_PASSWORD=change-me

# 前端对外端口（默认 8180；注意避开 TeleAgent 调度器占用的 8080）
# ⚠️ 安全：系统无任何鉴权，端口只绑定 127.0.0.1（仅本机可访问）。
#    切勿通过修改 docker-compose.yml 把 8180 暴露到局域网或公网；
#    如需远程访问请走 SSH 隧道（见 docs/deployment.md 第六节）。
PT_HTTP_PORT=8180

# 后端日志级别（DEBUG / INFO / WARNING）
LOG_LEVEL=INFO
